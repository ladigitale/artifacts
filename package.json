{
  "name": "artifacts",
  "version": "0.1.0",
  "scripts": {
    "generate-routes": "node scripts/run-generate-routes.mjs src/app/routes && node scripts/fix-router-order.mjs",
    "dev": "yarn generate-routes && vite --host --port 3300",
    "build": "yarn generate-routes && tsc --pretty false && vite build && yarn build:embed",
    "build:embed": "LIB_NAME=embed vite build",
    "preview": "vite preview --port 3300",
    "smoke": "VITE_API_BASE_URL=http://localhost:4455 vite build && node scripts/smoke-atelier.mjs",
    "smoke:sound": "VITE_API_BASE_URL=http://localhost:4455 vite build && node scripts/smoke-sound.mjs",
    "smoke:audio": "VITE_API_BASE_URL=http://localhost:4455 vite build && node scripts/smoke-audio.mjs",
    "smoke:media": "VITE_API_BASE_URL=http://localhost:4455 vite build && node scripts/smoke-media.mjs",
    "smoke:embed": "VITE_API_BASE_URL=http://localhost:4455 vite build && VITE_API_BASE_URL=http://localhost:4455 yarn build:embed && node scripts/smoke-embed.mjs",
    "smoke:a2ui": "VITE_API_BASE_URL=http://localhost:4455 vite build && node scripts/smoke-a2ui.mjs"
  },
  "devDependencies": {
    "@supersoniks/concorde": "5.1.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.3.1",
    "lit": "^3.1.3",
    "playwright": "^1.55.0",
    "postcss": "^8.4.14",
    "prettier": "^3.0.3",
    "rollup-plugin-postcss-lit": "^2.1.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@ladigitale/agent-stack": "github:ladigitale/agent-stack#41079900498b107683f52678386ea24885a5a64b",
    "@supersoniks/creative-stack": "github:ladigitale/creative-stack#26207411c465a7f3b9b63e7177ff770a52bf6a88",
    "three": "0.180.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
