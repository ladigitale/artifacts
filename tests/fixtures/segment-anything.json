{
 "schema": "artifacts/1",
 "title": "Détourage SAM 2",
 "theme": "default",
 "defaultView": "main",
 "views": [
  {
   "id": "main",
   "title": "Détourage",
   "root": {
    "nodes": [
     {
      "tagName": "sonic-still",
      "attributes": {
       "id": "photo",
       "src": "data:image/png;base64,",
       "style": "display:block;width:400px;height:400px"
      }
     },
     {
      "tagName": "sonic-segment-anything",
      "attributes": {
       "id": "objet",
       "for": "photo",
       "click-on": "photo",
       "consent-provider": "ok.sam",
       "out-data-provider": "objet"
      }
     },
     {
      "tagName": "sonic-mask-replace",
      "attributes": {
       "id": "rendu",
       "source": "photo",
       "mask": "objet",
       "effect": "blur",
       "style": "display:block;width:400px;height:400px"
      }
     }
    ]
   }
  }
 ]
}
