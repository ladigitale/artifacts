{"schema":"artifacts/1","title":"Plasma","defaultView":"scene","views":[{"id":"scene","title":"Plasma","root":{"nodes":[{"tagName":"div","attributes":{"style":"display:flex;flex-direction:column;gap:.8rem;max-width:44rem;margin:1rem auto;padding:0 1rem"},"nodes":[{"tagName":"sonic-store","attributes":{"id":"sceneui","reducer":"$state","initial":"{\"title\":\"Plasma\",\"help\":\"Clique ou touche l'image pour déplacer le centre des ondes.\",\"controls\":[{\"label\":\"Vitesse\",\"min\":0,\"max\":3,\"step\":0.25,\"value\":1},{\"label\":\"Échelle\",\"min\":1,\"max\":12,\"step\":1,\"value\":4},{\"label\":\"Teinte\",\"min\":0,\"max\":1,\"step\":0.05,\"value\":0.6}],\"txt\":{\"minus\":\"−\",\"plus\":\"+\",\"random\":\"Hasard\",\"reset\":\"Réinitialiser\"}}"}},{"tagName":"sonic-store","attributes":{"id":"scene","boot-action":"init","budget-ms":"40","reducer":"(\n  $s := $state; $a := $action; $t := $a.type;\n  $C := $s.controls;\n  $key := function($k) { \"param\" & $string($k) };\n  $set := function($st, $k, $v) { (\n    $c := $C[$k];\n    $merge([$st, {$key($k): $round($clamp($v, $c.min, $c.max), 4)}])\n  ) };\n  $defaults := $reduce([0..($count($C) - 1)], function($acc, $k) { $merge([$acc, {$key($k): $C[$k].value}]) }, {});\n  $k := $a.payload.p;\n  $t = \"init\" or $t = \"reset\" ? $merge([$s, $count($C) > 0 ? $defaults : {}]) :\n  $t = \"inc\" and $k < $count($C) ? $set($s, $k, $lookup($s, $key($k)) + $C[$k].step) :\n  $t = \"dec\" and $k < $count($C) ? $set($s, $k, $lookup($s, $key($k)) - $C[$k].step) :\n  $t = \"random\" and $count($C) > 0 ? (\n    $r := $reduce([0..($count($C) - 1)], function($acc, $k) { (\n      $x := $rand($acc.seed);\n      $c := $C[$k];\n      $v := $c.min + $x.value * ($c.max - $c.min);\n      $q := $c.step > 0 ? $c.min + $round(($v - $c.min) / $c.step) * $c.step : $v;\n      {\"seed\": $x.seed, \"vals\": $merge([$acc.vals, {$key($k): $round($clamp($q, $c.min, $c.max), 4)}])}\n    ) }, {\"seed\": $s.seed, \"vals\": {}});\n    $merge([$s, $r.vals, {\"seed\": $r.seed}])\n  ) :\n  $s\n)","initial":"{\"controls\":[{\"label\":\"Vitesse\",\"min\":0,\"max\":3,\"step\":0.25,\"value\":1},{\"label\":\"Échelle\",\"min\":1,\"max\":12,\"step\":1,\"value\":4},{\"label\":\"Teinte\",\"min\":0,\"max\":1,\"step\":0.05,\"value\":0.6}],\"seed\":2026,\"param0\":0,\"param1\":0,\"param2\":0,\"param3\":0}"}},{"tagName":"h1","attributes":{"style":"font-size:1.5rem;font-weight:700;margin:0"},"nodes":[{"tagName":"sonic-value","attributes":{"dataProvider":"sceneui","key":"title"}}]},{"tagName":"div","attributes":{"style":"border-radius:1rem;overflow:hidden;background:#05050a;box-shadow:0 10px 40px rgba(0,0,0,.3)"},"nodes":[{"tagName":"sonic-shader","attributes":{"dataProvider":"scene","image":"vec3 pal(float t){ return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67))); }\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 p = (2.0 * f - iResolution.xy) / min(iResolution.x, iResolution.y);\n  float t = iTime * uParam0;\n  float s = uParam1;\n  vec2 m = iMouse.z > 0.0 ? (2.0 * iMouse.xy - iResolution.xy) / min(iResolution.x, iResolution.y) : vec2(0.0);\n  float v = sin(p.x * s + t) + sin(p.y * s * 1.3 - t * 1.1)\n          + sin((p.x + p.y) * s * 0.7 + t * 0.7) + sin(length(p - m) * s * 1.6 - t * 1.4);\n  vec3 col = pal(uParam2 + v * 0.15);\n  col *= 0.75 + 0.25 * sin(v * 3.14159);\n  o = vec4(col, 1.0);\n}\n","aspect-ratio":1.6,"dpr-max":"1.5","play":true,"mouse":true,"style":"display:block;width:100%"}}]},{"tagName":"div","attributes":{"style":"display:flex;flex-direction:column;gap:.45rem"},"nodes":[{"tagName":"div","attributes":{"style":"display:grid;grid-template-columns:1fr 2.6rem 4rem 2.6rem;gap:.4rem;align-items:center","data-control":"0"},"nodes":[{"tagName":"span","attributes":{"style":"font-size:.9rem"},"nodes":[{"tagName":"sonic-value","attributes":{"dataProvider":"sceneui","key":"controls.0.label"}}]},{"tagName":"sonic-action","attributes":{"target":"scene","type":"dec","payload":"{\"p\": 0}"},"nodes":[{"tagName":"sonic-b