 "files": {
  "banc.jsonata": "(\n  $s := $state;\n  $t := $action.type;\n  $p := $action.payload;\n  $now := $action.t;\n\n  $stat := function($a) {\n    $count($a) = 0 ? {\"n\": 0, \"mean\": null, \"sd\": null, \"min\": null, \"max\": null} : (\n      $m := $average($a);\n      {\n        \"n\": $count($a),\n        \"mean\": $round($m, 1),\n        \"sd\": $count($a) > 1 ? $round($sqrt($sum($map($a, function($v) { ($v - $m) * ($v - $m) })) / ($count($a) - 1)), 1) : 0,\n        \"min\": $round($min($a), 1),\n        \"max\": $round($max($a), 1)\n      }\n    )\n  };\n\n  $finish := function($st, $why) {(\n    $on := $stat($st.latOn);\n    $off := $stat($st.latOff);\n    $rows := $map([400, 300, 200, 150, 100, 70, 50], function($d) {(\n      $ps := $filter($st.pulses, function($x) { $x.d = $d });\n      $obs := $stat($map($ps, function($x) { $x.obs }));\n      {\n        \"d\": $d,\n        \"sent\": 4,\n        \"seen\": $count($ps),\n        \"cmd\": $count($ps) > 0 ? $round($average($map($ps, function($x) { $x.cmd })), 1) : null,\n        \"obs\": $obs,\n        \"ok\": $count($ps) = 4 and $obs.sd <= 0.2 * $d\n      }\n    )});\n    $chain := $reduce($rows, function($acc, $r) { $acc.ok and $r.ok ? {\"ok\": true, \"min\": $r.d} : {\"ok\": false, \"min\": $acc.min} }, {\"ok\": true, \"min\": 0});\n    $torchOk := $on.n >= 3 and $off.n >= 3;\n    $sigma := $torchOk ? $sqrt($on.sd * $on.sd + $off.sd * $off.sd) : 0;\n    $frame := $st.fps > 0 ? 1000 / $st.fps : 33.3;\n    $dot := $torchOk and $chain.min > 0 ? $ceil($max([$chain.min, 6 * $sigma, 4 * $frame]) / 10) * 10 : 0;\n    $verdict := $why != \"\" ? $why\n      : $not($torchOk) ? \"La torche ne répond pas, ou son reflet est trop faible\"\n      : $dot = 0 ? \"Torche trop irrégulière, même à 400 ms\"\n      : \"Point conseillé : \" & $dot & \" ms, soit \" & $round(1200 / $dot, 1) & \" mots/minute\";\n    $merge([$st, {\n      \"phase\": $why != \"\" ? \"error\" : \"done\",\n      \"torch\": false,\n      \"msg\": $verdict,\n      \"notice\": $dot > 0 ? $st.notice : $verdict,\n      \"result\": {\n        \"ok\": $dot > 0,\n        \"verdict\": $verdict,\n        \"appareil\": $st.appareil,\n        \"dotMs\": $dot,\n        \"wpm\": $dot > 0 ? $round(1200 / $dot, 1) : 0,\n        \"fps\": $st.fps,\n        \"frameMs\": $round($frame, 1),\n        \"clock\": $st.clock,\n        \"on\": $on,\n        \"off\": $off,\n        \"stretchMs\": $torchOk ? $round($off.mean - $on.mean, 1) : null,\n        \"pulses\": $rows,\n        \"latOn\": $st.latOn,\n        \"latOff\": $st.latOff,\n        \"camError\": $st.camError,\n        \"torchError\": $st.torchError\n      }\n    }])\n  )};\n\n  $t = \"io:input\" ? $merge([$s, {\"appareil\": $string($p.appareil ? $p.appareil : \"\")}]) :\n  $t = \"camReady\" ? $merge([$s, {\"cam\": true}]) :\n  $t = \"torchError\" ? $merge([$s, {\"torchError\": $string($p.value)}]) :\n  $t = \"camError\" ? (\n    $s.phase = \"done\" or $s.phase = \"error\" ? $s\n      : $finish($merge([$s, {\"camError\": $string($p.value)}]), \"Caméra indisponible : \" & $string($p.value))\n  ) :\n  $t = \"edge\" ? (\n    $s.phase = \"p1\" and $p.sinceMark != null ? (\n      $p.on\n        ? $merge([$s, {\"latOn\": $append($s.latOn, [$p.sinceMark]), \"fps\": $p.fps, \"clock\": $p.clock}])\n        : $merge([$s, {\"latOff\": $append($s.latOff, [$p.sinceMark]), \"fps\": $p.fps, \"clock\": $p.clock}])\n    ) :\n    $s.phase = \"p2\" and $p.on = false and $p.markGap != null ? (\n      $merge([$s, {\"pulses\": $append($s.pulses, [{\"d\": $s.plan[$s.i].d, \"cmd\": $p.markGap, \"obs\": $p.dur}]), \"fps\": $p.fps}])\n    )\n  ) :\n  $t = \"tick\" ? (\n    $s.phase = \"idle\" ? ($s.run = \"1\" ? $merge([$s, {\"phase\": \"wait\", \"msg\": \"Ouverture de la caméra\"}])) :\n    $s.phase = \"wait\" ? ($s.cam ? $merge([$s, {\"phase\": \"settle\", \"nextT\": $now + 1500, \"msg\": \"Stabilisation\"}])) :\n    $s.phase = \"settle\" or $s.phase = \"p1\" or $s.phase = \"p2\" ? (\n      $now >= $s.nextT ? (\n        $n := $s.i + 1;\n        $total := $count($s.plan);\n        $n >= $total ? $finish($s, \"\") : (\n          $st := $s.plan[$n];\n          $st.d > 0 and $s.phase = \"p1\" and ($count($s.latOn) < 3 or $count($s.latOff) < 3) ? $finish($s, \"\") :\n          $merge([$s, {\n            \"i\": $n,\n            \"torch\": $st.on,\n            \"nextT\": $s.nextT + $st.hold,\n            \"phase\": $st.d > 0 ? \"p2\" : \"p1\",\n            \"msg\": \"Mesure \" & ($n + 1) & \" / \" & $total\n          }])\n        )\n      )\n    )\n  ) :\n  $s\n)\n"
 },
