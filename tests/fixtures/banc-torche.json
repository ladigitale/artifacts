 "io": {
  "title": "Banc torche",
  "description": "Mesure sur un téléphone la latence d'allumage et d'extinction de la torche, vue par sa propre caméra (reflet sur un mur), puis la tenue d'impulsions de 400 à 50 ms. Renvoie les statistiques et une durée de point conseillée pour du morse à la torche.",
  "modes": [
   "interactive"
  ],
  "input": {
   "schema": {
    "type": "object",
    "properties": {
     "appareil": {
      "type": "string",
      "maxLength": 80,
      "description": "Nom libre du téléphone testé"
     }
    },
    "additionalProperties": false
   },
   "store": "banc"
  },
  "output": {
   "from": "banc.result",
   "when": "phase = 'done' or phase = 'error'",
   "schema": {
    "type": "object",
    "required": [
     "ok",
     "verdict"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "verdict": {
      "type": "string"
     },
     "appareil": {
      "type": "string"
     },
     "dotMs": {
      "type": "number"
     },
     "wpm": {
      "type": "number"
     },
     "fps": {
      "type": "number"
     },
     "frameMs": {
      "type": "number"
     },
     "clock": {
      "type": "string"
     },
     "on": {
      "type": "object",
      "properties": {
       "n": {
        "type": "integer"
       },
       "mean": {
        "type": [
         "number",
         "null"
        ]
       },
       "sd": {
        "type": [
         "number",
         "null"
        ]
       },
       "min": {
        "type": [
         "number",
         "null"
        ]
       },
       "max": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     },
     "off": {
      "type": "object",
      "properties": {
       "n": {
        "type": "integer"
       },
       "mean": {
        "type": [
         "number",
         "null"
        ]
       },
       "sd": {
        "type": [
         "number",
         "null"
        ]
       },
       "min": {
        "type": [
         "number",
         "null"
        ]
       },
       "max": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     },
     "stretchMs": {
      "type": [
       "number",
       "null"
      ]
     },
     "pulses": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "latOn": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "latOff": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "camError": {
      "type": "string"
     },
     "torchError": {
      "type": "string"
     }
    }
   }
  }
 },
