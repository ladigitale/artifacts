 := $action.type;\n  $s := $state;\n  $W := $s.w; $H := $s.h;\n  $cx := ($W - 1) / 2; $cy := ($H - 1) / 2;\n  $render := function($s){(\n    $f := $s.frame; $m := $s.mode; $k := $s.colors;\n    $cells := $map($range($W * $H), function($i){(\n      $x := $i % $W; $y := $floor($i / $W);\n      $dx := $x - $cx; $dy := $y - $cy;\n      $v := $m = 0 ? $round($sqrt($dx*$dx + $dy*$dy)) - $f :\n            $m = 1 ? ($abs($dx) > $abs($dy) ? $abs($dx) : $abs($dy)) * 2 - $f :\n            $m = 2 ? $floor(($x + $y) / 2) - $f + $floor(($x * $y) / 6) :\n                     $floor(($dx*$dx - $dy*$dy) / 8) - $f;\n      1 + (($v % $k) + $k) % $k + $s.theme * 8\n    )});\n    $merge([$s, {\"cells\": $cells, \"modeLabel\": $s.modes[$s.mode]}])\n  )};\n  $t = \"tick\" ? ($s.running ? $render($merge([$s, {\"frame\": $s.frame + $s.dir}])) : $s) :\n  $t = \"init\" ? $render($s) :\n  $t = \"mode\" or $t = \"tap\" ? $render($merge([$s, {\"mode\": ($s.mode + 1) % 4}])) :\n  $t = \"toggle\" or $t = \"long-press\" ? $merge([$s, {\"running\": $not($s.running)}]) :\n  $t = \"reverse\" or $t = \"double-tap\" ? $merge([$s, {\"dir\": -$s.dir}]) :\n  $t = \"theme\" or $t = \"swipe-right\" ? $render($merge([$s, {\"theme\": ($s.theme + 1) % 3}])) :\n  $t = \"swipe-left\" ? $render($merge([$s, {\"theme\": ($s.theme + 2) % 3}])) :\n  $t = \"faster\" or $t = \"swipe-up\" ? $merge([$s, {\"speed\": $clamp($s.speed - 30, 40, 400)}]) :\n  $t = \"slower\" or $t = \"swipe-down\" ? $merge([$s, {\"speed\": $clamp($s.speed + 30, 40, 400)}]) :\n  $t = \"more\" ? $render($merge([$s, {\"colors\": $clamp($s.colors + 1, 2, 8)}])) :\n  $t = \"less\" ? $render($merge([$s, {\"colors\": $clamp($s.colors - 1, 2, 8)}])) :\n  $s\n)", "budget-ms": "150"}}, {"tagName": "sonic-ticker", "attributes": {"target": "mosaic", "interval": "110", "interval-key": "speed", "running-key": "running"}}, {"tagName": "sonic-keyboard", "attributes": {"target": "mosaic", "scope": "document", "keymap": "{\"KeyM\": \"mode\", \"ArrowRight\": \"th