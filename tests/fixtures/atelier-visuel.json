{"schema": "artifacts/1", "title": "Atelier visuel", "theme": "default", "defaultView": "kaleido", "data": {"transforms": {"t": {"jsonata": "{\"titre\": \"Atelier visuel\", \"intro\": \"Deux jouets 100 % déclaratifs : un store JSONata, des gestes, des boutons et le clavier pilotent un shader et une mosaïque. Aucun script dans l'artefact.\", \"k_titre\": \"Kaléidoscope\", \"k_aide\": \"Glisse ← → : branches · ↑ ↓ : zoom · Tape : couleur · Double-tape : hasard · Appui long : torsion\", \"k_kbd\": \"Clavier : flèches, C couleur, Espace hasard, T torsion\", \"m_titre\": \"Mosaïque\", \"m_aide\": \"Tape : motif · Glisse ← → : palette · ↑ ↓ : vitesse · Double-tape : sens · Appui long : pause\", \"m_kbd\": \"Clavier : M motif, ← → palette, ↑ ↓ vitesse, R sens, Espace pause\", \"b_symm\": \"− branches\", \"b_symp\": \"+ branches\", \"b_zm\": \"Zoom −\", \"b_zp\": \"Zoom +\", \"b_color\": \"Couleur\", \"b_rand\": \"Hasard\", \"b_twist\": \"Torsion\", \"b_reset\": \"Réinitialiser\", \"b_mode\": \"Motif\", \"b_theme\": \"Palette\", \"b_rev\": \"Sens\", \"b_pause\": \"Pause / lecture\", \"b_slow\": \"Plus lent\", \"b_fast\": \"Plus vite\", \"b_less\": \"− couleurs\", \"b_more\": \"+ couleurs\", \"pause\": \"En pause\", \"zoom\": \"Zoom\", \"image\": \"Image\", \"vitesse\": \"ms / image\"}"}}}, "views": [{"id": "kaleido", "title": "Kaléidoscope", "root": {"nodes": [{"tagName": "div", "attributes": {"style": "display:flex;flex-direction:column;gap:1rem;max-width:34rem;margin:0 auto"}, "nodes": [{"tagName": "sonic-store", "attributes": {"id": "kalei", "initial": "{\"sym\": 6, \"hue\": 0.58, \"zoom\": 1.4, \"twist\": 1, \"seed\": 2026, \"param0\": 0.58, \"param1\": 6, \"param2\": 1.4, \"param3\": 1, \"symLabel\": \"6 branches\", \"running\": true}", "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $view := function($s){ $merge([$s, {\n    \"param0\": $s.hue, \"param1\": $s.sym, \"param2\": $s.zoom, \"param3\": $s.twist,\n    \"symLabel\": $string($s.sym) & \" branches\",\n    \"running\": true\n  }]) };\n  $t = \"sym+\" or $t = \"swipe-right\" ? $view($merge([$s, {\"sym\": $clamp($s.sym + 1, 2, 16)}])) :\n  $t = \"sym-\" or $t = \"swipe-left\" ? $view($merge([$s, {\"sym\": $clamp($s.sym - 1, 2, 16)}])) :\n  $t = \"zoom+\" or $t = \"swipe-up\" ? $view($merge([$s, {\"zoom\": $clamp($round($s.zoom * 1.25, 3), 0.3, 6)}])) :\n  $t = \"zoom-\" or $t = \"swipe-down\" ? $view($merge([$s, {\"zoom\": $clamp($round($s.zoom / 1.25, 3), 0.3, 6)}])) :\n  $t = \"color\" or $t = \"tap\" ? $view($merge([$s, {\"hue\": $round(($s.hue + 0.137) % 1, 3)}])) :\n  $t = \"twist\" or $t = \"long-press\" ? $view($merge([$s, {\"twist\": $s.twist > 0 ? 0 : 1}])) :\n  $t = \"random\" or $t = \"double-tap\" ? (\n    $a := $rand($s.seed); $b := $rand($a.seed); $c := $rand($b.seed); $d := $rand($c.seed);\n    $view($merge([$s, {\n      \"hue\": $round($a.value, 3),\n      \"sym\": 3 + $floor($b.value * 10),\n      \"zoom\": $round(0.6 + $c.value * 2.4, 3),\n      \"twist\": $d.value > 0.5 ? 1 : 0,\n      \"seed\": $d.seed\n    }]))\n  ) :\n  $t = \"init\" ? $view($s) :\n  $s\n)", "budget-ms": "40"}}, {"tagName": "sonic-keyboard", "attributes": {"target": "kalei", "scope": "document", "keymap": "{\"ArrowLeft\": \"sym-\", \"ArrowRight\": \"sym+\", \"ArrowUp\": \"zoom+\", \"ArrowDown\": \"zoom-\", \"KeyC\": \"color\", \"Space\": \"random\", \"KeyT\": \"twist\"}", "repeat": "{\"zoom+\": [250, 120], \"zoom-\": [250, 120]}"}}, {"tagName": "header", "attributes": {"class": "flex flex-col gap-1"}, "nodes": [{"tagName": "h1", "nodes": [{"tagName": "sonic-value", "attributes": {"dataProvider": "t", "key": "k_titre"}}], "attributes": {"class": "text-2xl font-bold m-0"}}, {"tagName": "p", "nodes": [{"tagName": "sonic-value", "attributes": {"dataProvider": "t", "key": "k_aide"}}], "attributes": {"class": "m-0 text-sm opacity-70"}}]}, {"tagName": "sonic-gesture", "attributes": {"target": "kalei", "style": "position:relative;border-radius:1rem;overflow:hidden;background:#05050a;box-shadow:0 10px 40px rgba(0,0,0,.35)"}, "nodes": [{"tagName": "sonic-shader", "attributes": {"dataProvider": "kalei", "aspect-ratio": "1", "dpr-max": "1.5", "style": "display:block;width:100%", "image": "vec3 pal(float t){ return 0.5 + 0.5*cos(6.28318*(t + vec3(0.0, 0.33, 0.67))); }\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 p = (2.0*f - iResolution.xy) / min(iResolution.x, iResolution.y);\n  float sym = max(floor(uParam1 + 0.5), 2.0);\n  float zoom = max(uParam2, 0.1);\n  float t = iTime * 0.2;\n  float r = length(p);\n  float a = atan(p.y, p.x) + t * 0.5 + uParam3 * 1.6 * sin(iTime * 0.35) * r;\n  float seg = 6.28318 / sym;\n  a = mod(a, seg);\n  a = abs(a - seg * 0.5);\n  vec2 q = vec2(cos(a), sin(a)) * r * zoom + vec2(0.15 * sin(t * 1.7), 0.1 * cos(t * 1.3));\n  float trapL = 10.0;\n  float trapP = 10.0;\n  float acc = 0.0;\n  for (int i = 0; i < 7; i++) {\n    q = abs(q) / dot(q, q) - vec2(0.82 + 0.08 * sin(t * 1.1), 0.55 + 0.08 * cos(t * 0.9));\n    trapL = min(trapL, abs(q.y));\n    trapP = min(trapP, length(q - vec2(0.3, 0.0)));\n    acc += exp(-length(q) * 2.0);\n  }\n  vec3 base = pal(uParam0 + acc * 0.12 + t * 0.1) * 0.35 * smoothstep(0.0, 1.2, acc);\n  vec3 lines = pal(uParam0 + 0.33 + trapP * 0.4) * exp(-trapL * 18.0);\n  vec3 dots = pal(uParam0 + 0.66) * exp(-trapP * 9.0) * 1.2;\n  vec3 col = base + lines + dots;\n  col *= smoothstep(1.6, 0.25, r);\n  col = col / (1.0 + col * 0.25);\n  o = vec4(pow(col, vec3(0.9)), 1.0);\n}\n"}}]}, {"tagName": "div", "attributes": {"class": "flex flex-wrap gap-2 items-center"}, "nodes": [{"tagName": "sonic-badge", "attributes": {"type": "neutral"}, "nodes": [{"tagName": "sonic-value", "attributes": {"dataProvider": "kalei", "key": "symLabel"}}]}, {"tagName": "sonic-badge", "attributes": {"type": "neutral"}, "nodes": [{"tagName": "sonic-value", "attributes": {"dataProvider": "t", "key": "zoom"}}, {"tagName": "span", "nodes": [{"tagName": "sonic-value", "attributes": {"dataProvider": "kalei", "key": "zoom"}}]}]}]}, {