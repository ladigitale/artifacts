        "textContent": "Chambre en VR / AR"
       },
       {
        "tagName": "sonic-store",
        "attributes": {
         "id": "chambre",
         "initial": "{\"vise\": \"—\"}",
         "reducer": "$action.type = 'xr:select' ? $merge([$state, {'vise': $exists($action.payload.instance) ? $action.payload.instance : '—'}]) : $action.type = 'pick' ? $merge([$state, {'vise': $exists($action.payload.instance) ? $action.payload.instance : '—'}]) : $state"
        }
       },
       {
        "tagName": "sonic-3d",
        "attributes": {
         "id": "scene",
         "monde": "{\"unite\": \"cm\", \"espace\": {\"contour\": [[0, 0], [440, 0], [440, 330], [0, 330]], \"hauteur\": 250, \"zones\": [{\"nom\": \"plancher\", \"revetement\": \"parquet\"}], \"plafond\": true}, \"place\": [{\"model\": \"lit\", \"name\": \"lit\", \"against\": \"mur2\", \"at\": 85, \"params\": {\"type\": \"mezzanine\", \"couette\": \"#e07a5f\"}}, {\"model\": \"bureau\", \"name\": \"bureau\", \"against\": \"mur0\", \"at\": 310, \"params\": {\"largeur\": 140, \"caisson\": true}}, {\"model\": \"lampe\", \"on\": \"bureau\", \"at\": [-50, 0], \"params\": {\"abat\": \"boule\"}}, {\"model\": \"etagere\", \"on\": \"mur0\", \"at\": [120, 125], \"params\": {\"niveaux\": 3, \"largeur\": 100}}, {\"model\": \"plante\", \"name\": \"plante\", \"against\": \"mur1\", \"at\": 40}, {\"model\": \"suspension\", \"on\": \"plafond\", \"at\": [220, 165]}, {\"model\": \"tapis\", \"on\": \"plancher\", \"at\": [240, 150], \"params\": {\"forme\": \"rond\", \"largeur\": 150}}, {\"model\": \"coussin\", \"on\": \"lit\"}]}",
         "target": "chambre",
         "pick": true,
         "style": "display:block;width:100%;height:460px;border-radius:16px"
        }
       },
       {
        "tagName": "sonic-xr",
        "attributes": {
         "id": "casque",
         "target": "scene",
         "for": "entrer poser regard quitter",
         "mode": "auto",
         "store": "chambre",
         "features": "hit-test dom-overlay",
         "overlay": "hud",
         "reticle": true
