{"schema":"artifacts/1","title":"Repas de quartier","defaultView":"form","data":{"sources":{"answers":{"collection":"reponses","intake":{"maxRecords":200,"fields":{"vient":{"type":"enum","values":["Oui","Non"],"required":true},"personnes":{"type":"integer","min":1,"max":8,"required":false},"plat":{"type":"enum","values":["Entrée","Plat","Dessert","Boissons"],"required":true},"aide":{"type":"string","max":200,"required":false},"nom":{"type":"string","max":200,"required":false},"remarque":{"type":"string","max":200,"required":false}}}}},"sinks":{"answers":{"collection":"reponses","from":"form.outbox","ack":"form"}},"stores":{"form":{"reducer":"(\n  $s := $state; $a := $action; $t := $a.type;\n  $clean := function($p) { $merge([{}, $each($p, function($v, $k) {\n    $k = \"surfaceId\" or $k = \"sourceComponentId\" ? {} :\n    {$k: $type($v) = \"array\" ? $join($v, \", \") : $lookup($s.types, $k) = \"number\" and $type($v) = \"string\" ? ($v = \"\" ? null : $number($v)) : $v}\n  })]) };\n  $t = \"send\" ? (\n    $data := $clean($a.payload);\n    $miss := [$filter($s.required, function($r) { (\n      $v := $lookup($data, $r.id);\n      $not($exists($v)) or $v = \"\" or $v = null\n    ) })];\n    $count($miss) > 0 ? $merge([$s, {\"msg\": $s.txt.missing & \" \" & $join($miss.label, \", \")}]) :\n    $s.sending ? $s :\n    $merge([$s, {\"outbox\": $append($s.outbox, [{\"id\": $string($round($a.t)), \"data\": $data}]), \"sending\": true, \"msg\": $s.txt.sending}])\n  ) :\n  $t = \"sink:ok\" ? $merge([$s, {\"outbox\": [$filter($s.outbox, function($o) { $o.id != $a.payload.id })], \"sending\": false, \"sent\": $s.sent + 1, \"msg\": $s.txt.thanks}]) :\n  $t = \"sink:error\" ? $merge([$s, {\"outbox\": [$filter($s.outbox, function($o) { $o.id != $a.payload.id })], \"sending\": false, \"msg\": $s.txt.error}]) :\n  $s\n)","initial":{"outbox":[],"sending":false,"sent":0,"msg":"","required":[{"id":"vient","label":"Tu viens ?"},{"id":"plat","label":"Tu apportes…"}],"types":{"vient":"text","personnes":"number","plat":"text","aide":"text","nom":"text","remarque":"text"},"txt":{"missing":"Il manque :","sending":"Envoi…","thanks":"Merci, ta réponse est enregistrée !","error":"L'envoi a échoué : la collecte est peut-être fermée. Réessaie plus tard."}}}}},"views":[{"id":"form","title":"Repas de quartier","actionStore":"form","a2uiBindings":{"/store":"form"},"a2ui":[{"version":"v0.9","createSurface":{"surfaceId":"form","catalogId":"https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"}},{"version":"v0.9","updateComponents":{"surfaceId":"form","components":[{"id":"root","component":"Column","children":["title","intro","f-vient","f-personnes","f-plat","f-aide","f-nom","f-remarque","actions"]},{"id":"title","component":"Text","variant":"h2","text":"Repas de quartier"},{"id":"intro","component":"Text","text":"Aide-nous à organiser le repas du 14 juin."},{"id":"f-vient","component":"ChoicePicker","label":"Tu viens ? *","variant":"mutuallyExclusive","options":[{"label":"Oui","value":"Oui"},{"label":"Non","value":"Non"}],"value":{"path":"/form/vient"}},{"id":"f-personnes","component":"Slider","label":"Combien de personnes ?","min":1,"max":8,"value":{"path":"/form/personnes"}},{"id":"f-plat","component":"ChoicePicker","label":"Tu apportes… *","variant":"mutuallyExclusive","options":[{"label":"Entrée","value":"Entrée"},{"label":"Plat","value":"Plat"},{"label":"Dessert","value":"Dessert"},{"label":"Boissons","value":"Boissons"}],"value":{"path":"/form/plat"}},{"id":"f-aide","component":"ChoicePicker","label":"Tu peux aider à…","variant":"multipleSelection","options":[{"label":"Installer","value":"Installer"},{"label":"Ranger","value":"Ranger"},{"label":"Cuisiner","value":"Cuisiner"}],"value":{"path":"/form/aide"}},{"id":"f-nom","component":"TextField","label":"Ton prénom","variant":"shortText","value":{"path":"/form/nom"}},{"id":"f-remarque","component":"TextField","label":"Une remarque ?","variant":"longText","value":{"path":"/form/remarque"}},{"id":"