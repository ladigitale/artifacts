{
 "schema": "artifacts/1",
 "title": "Morse torche",
 "theme": "default",
 "defaultView": "chat",
 "icon": {
  "emoji": "🔦",
  "background": "#101014",
  "color": "#ffffff"
 },
 "capabilities": [
  "camera"
 ],
 "files": {
  "chat.jsonata": "(\n  $s := $state;\n  $t := $action.type;\n  $p := $action.payload;\n  $add := function($who, $text) {\n    $merge([$s, {\n      \"seq\": $s.seq + 1,\n      \"messages\": $append($s.messages, [{\"id\": \"m\" & ($s.seq + 1), \"who\": $who, \"text\": $text}])\n    }])\n  };\n\n  $t = \"tick\" ? (\n    $s.phrase != \"\" ? $merge([$add(\"moi\", $s.phrase), {\"phrase\": \"\", \"outgoing\": $s.phrase, \"txN\": $s.txN + 1}]) :\n    $s.go = \"1\" ? (\n      $txt := $trim($string($s.draft));\n      $txt = \"\" ? $merge([$s, {\"go\": \"\"}])\n        : $merge([$add(\"moi\", $txt), {\"go\": \"\", \"draft\": \"\", \"outgoing\": $txt, \"txN\": $s.txN + 1}])\n    )\n  ) :\n  $t = \"morse:message\" ? $add(\"autre\", $string($p.text)) :\n  $t = \"torchError\" ? ($s.notice = \"\" ? $merge([$s, {\"notice\": \"Pas de torche sur cet appareil : réception seule\"}]) : $s) :\n  $s\n)\n"
 },
 "data": {
  "stores": {
   "chat": {
    "initial": {
     "draft": "",
     "go": "",
     "phrase": "",
     "outgoing": "",
     "txN": 0,
     "seq": 0,
     "notice": "",
     "messages": []
    },
    "reducer": "@file:chat.jsonata",
    "budgetMs": 50
   },
   "lampe": {
    "initial": {
     "torch": false
    },
    "reducer": "$state"
   },
   "reglages": {
    "initial": {
     "unit": "300",
     "measure": "mean",
     "codec": "fast"
    },
    "reducer": "$state"
   }
  }
 },
 "views": [
  {
   "id": "chat",
   "title": "Chat",
   "root": {
    "nodes": [
     {
      "tagName": "sonic-wake-lock",
      "attributes": {
       "id": "veille",
       "auto": true
      }
     },
     {
      "tagName": "sonic-ticker",
      "attributes": {
       "target": "chat",
       "interval": "100"
      }
     },
     {
      "tagName": "sonic-luma",
      "attributes": {
       "id": "sonde",
       "source": "#cam",
       "detect": "jump",
       "max-on-ms": "4000",
       "params": "reglages"
      }
     },
     {
      "tagName": "sonic-morse",
      "attributes": {
       "id": "morse",
       "unit": "300",
       "trim": "30",
       "codec": "fast",
       "phrases": "[[\"OUI\", 320], [\"NON\", 280], [\"OK\", 260], [\"MERCI\", 220], [\"PEUT-ETRE\", 80], [\"JAMAIS\", 60], [\"COMPRIS\", 110], [\"PAS COMPRIS\", 90], [\"REPETE\", 100], [\"BIEN RECU\", 90], [\"MDR\", 240], [\"BRAVO\", 80], [\"TROP BIEN\", 100], [\"NUL\", 70], [\"QUOI ?\", 110], [\"SERIEUX ?\", 80], [\"AU SECOURS\", 70], [\"BIEN JOUE\", 80], [\"MISSION ACCOMPLIE\", 70], [\"C'EST BON\", 120], [\"PERSONNE\", 70], [\"ON NOUS REGARDE\", 60], [\"CACHE TOI\", 70], [\"VITE\", 90], [\"SILENCE\", 80], [\"PAS BOUGER\", 60], [\"LE CODE EST BON\", 50], [\"LA VOIE EST LIBRE\", 60], [\"J'ARRIVE\", 200], [\"ATTENDS MOI\", 120], [\"OU ES TU ?\", 130], [\"JE SUIS LA\", 110], [\"REGARDE ICI\", 80], [\"SUIS MOI\", 80], [\"A TOI\", 70], [\"A TOI DE JOUER\", 60], [\"SALUT\", 220], [\"BONJOUR\", 100], [\"A DEMAIN\", 90], [\"FIN DU MESSAGE\", 60]]",
       "drive": "lampe.torch",
       "text-from": "chat.outgoing",
       "send-from": "chat.txN",
       "source": "sondeState",
       "target": "chat",
       "params": "reglages"
      }
     },
     {
      "tagName": "sonic-trigger",
