{
 "schema": "artifacts/1",
 "title": "Compter des objets",
 "theme": "default",
 "defaultView": "main",
 "views": [
  {
   "id": "main",
   "title": "Compter",
   "root": {
    "nodes": [
     {
      "tagName": "div",
      "attributes": {
       "style": "padding:1rem;max-width:32rem"
      },
      "nodes": [
       {
        "tagName": "div",
        "attributes": {
         "style": "position:relative;width:400px;height:300px"
        },
        "nodes": [
         {
          "tagName": "sonic-still",
          "attributes": {
           "id": "img",
           "src": "data:image/png;base64,",
           "fit": "contain",
           "style": "position:absolute;inset:0;width:100%;height:100%"
          }
         },
         {
          "tagName": "sonic-blobs",
          "attributes": {
           "id": "cnt",
           "source": "#img",
           "auto": true,
           "fit": "contain",
           "out-data-provider": "compte",
           "style": "position:absolute;inset:0;width:100%;height:100%"
          }
         }
        ]
       },
       {
        "tagName": "p",
        "nodes": [
         {
          "tagName": "span",
          "textContent": "Objets : "
         },
         {
          "tagName": "sonic-value",
          "attributes": {
           "dataProvider": "compte",
           "key": "count"
          }
         }
        ]
       }
      ]
     }
    ]
   }
  }
 ]
}