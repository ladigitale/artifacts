{
  "compilerOptions": {
    "target": "ES2020",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@tailwind": ["./src/css/tailwind.ts"],
      "@supersoniks/creative-stack/3d": ["./src/types/creative-stack-addons.d.ts"],
      "@supersoniks/creative-stack/webgpu": ["./src/types/creative-stack-addons.d.ts"],
      "@supersoniks/creative-stack/hugging-face-infer": ["./src/types/creative-stack-addons.d.ts"]
    }
  },
  "include": ["./src"]
}
